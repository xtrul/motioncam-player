#version 460

/*
 * Compute shader that replaces the previous placeholder RAW→YUV converter.
 * It performs:
 *   • simple bilinear demosaic on Bayer RAW (supports RGGB / BGGR / GRBG / GBRG)
 *   • per‑channel white‑balance gains
 *   • 3×3 colour‑matrix transform to linear Rec. 709 RGB
 *   • RGB → YUV 422 (10‑bit, full‑swing or limited‑swing selectable)
 *   • 10‑bit macropixel packing that matches FFmpeg’s AV_PIX_FMT_YUV422P10LE
 *
 * Push‑constant interface keeps CPU → GPU plumbing minimal.  The renderer only
 * has to fill in colour pipeline parameters that it already knows from the CPU
 * path.
 *
 * Author: ChatGPT 2025‑07‑12
 */

// Work‑group size – tweak to match your GPU
layout (local_size_x = 16, local_size_y = 16) in;

///////////////////////////////////////
// Push constants & bindings
///////////////////////////////////////

layout(push_constant) uniform PushConsts
{
    uint width;      // RAW/frame width  (pixels)
    uint height;     // RAW/frame height (pixels)
    uint cfaType;    // 0 = RGGB, 1 = BGGR, 2 = GRBG, 3 = GBRG
    uint fullSwing;  // 0 = limited (16‑235 / 64‑940), 1 = full swing 0‑1023
    float wbR;       // White‑balance gains already normalised so that wbG = 1
    float wbG;
    float wbB;
    mat3  colourMat; // 3×3 matrix to Rec.709 linear RGB (same as CPU path)
} pc;

// RAW input – single‑plane 16‑bit little‑endian (R16_UINT)
layout(binding = 0, r16ui) readonly uniform uimage2D rawImage;
// YUV 422 10‑bit output.  One RGBA32UI stores a macropixel (Y0 U Y1 V)
layout(binding = 1, rgba32ui) writeonly uniform uimage2D yuvImage;

///////////////////////////////////////
// Utility helpers
///////////////////////////////////////

// Clamp helpers for safety
uint clampu(uint v, uint lo, uint hi) { return (v < lo) ? lo : (v > hi) ? hi : v; }
float  clampf(float v, float lo, float hi) { return clamp(v, lo, hi); }

// Read one RAW sample safely (edge‑extend at image borders)
uint readRaw(uint x, uint y)
{
    x = clampu(x, 0u, pc.width  - 1u);
    y = clampu(y, 0u, pc.height - 1u);
    return imageLoad(rawImage, ivec2(int(x), int(y))).r;
}

// Simple 2×2 Bayer pattern helpers -------------------------------------------------

// Return true if current raw pixel location is red for the selected CFA pattern
bool isRed(uint x, uint y)
{
    bool xe = (x & 1u) == 0u;
    bool ye = (y & 1u) == 0u;
    switch(pc.cfaType)
    {
        case 0u: // RGGB (R at 0,0)
            return ye && xe;
        case 1u: // BGGR (B at 0,0)
            return (!ye) && (!xe);
        case 2u: // GRBG (G at 0,0, R at 1,0)
            return ye && (!xe);
        case 3u: // GBRG (G at 0,0, R at 0,1)
            return (!ye) && xe;
    }
    return false;
}

bool isBlue(uint x, uint y)
{
    bool xe = (x & 1u) == 0u;
    bool ye = (y & 1u) == 0u;
    switch(pc.cfaType)
    {
        case 0u: // RGGB
            return (!ye) && (!xe);
        case 1u: // BGGR
            return ye && xe;
        case 2u: // GRBG
            return (!ye) && xe;
        case 3u: // GBRG
            return ye && (!xe);
    }
    return false;
}

// Bilinear demosaic (fast & simple, good enough for preview/export) -----------------
vec3 demosaic(uint x, uint y)
{
    uint c = readRaw(x, y);
    uint left  = readRaw(x>0u ? x-1u : x, y);
    uint right = readRaw(min(x+1u, pc.width-1u), y);
    uint up    = readRaw(x, y>0u ? y-1u : y);
    uint down  = readRaw(x, min(y+1u, pc.height-1u));

    float r,g,b;

    if(isRed(x,y)) {
        r = float(c);
        // G from horizontal & vertical neighbours
        g = float(left + right + up + down) * 0.25;
        // B from diagonal
        uint diag = readRaw(x>0u?x-1u:x, y>0u?y-1u:y) +
                    readRaw(min(x+1u,pc.width-1u), y>0u?y-1u:y) +
                    readRaw(x>0u?x-1u:x, min(y+1u,pc.height-1u)) +
                    readRaw(min(x+1u,pc.width-1u), min(y+1u,pc.height-1u));
        b = float(diag) * 0.25;
    }
    else if(isBlue(x,y)) {
        b = float(c);
        g = float(left + right + up + down) * 0.25;
        uint diag = readRaw(x>0u?x-1u:x, y>0u?y-1u:y) +
                    readRaw(min(x+1u,pc.width-1u), y>0u?y-1u:y) +
                    readRaw(x>0u?x-1u:x, min(y+1u,pc.height-1u)) +
                    readRaw(min(x+1u,pc.width-1u), min(y+1u,pc.height-1u));
        r = float(diag) * 0.25;
    }
    else {
        // Green pixel
        g = float(c);
        if( ((y & 1u) == 0u && pc.cfaType <= 1u) || ((y & 1u) == 1u && pc.cfaType >= 2u))
        {
            // Green on Red row
            r = float(left + right) * 0.5;
            b = float(up + down) * 0.5;
        }
        else {
            // Green on Blue row
            r = float(up + down) * 0.5;
            b = float(left + right) * 0.5;
        }
    }

    // Apply white‑balance (already normalised so wbG ≈1)
    vec3 rgb = vec3(r*pc.wbR, g*pc.wbG, b*pc.wbB);
    // Normalise to 0‑1 (10‑bit RAW ⇒ divide by 1023.0)
    rgb   = clamp(rgb / 1023.0, 0.0, 1.0);
    // Colour matrix to Rec. 709 linear RGB
    rgb   = pc.colourMat * rgb;
    rgb   = clamp(rgb, 0.0, 1.0);
    return rgb;
}

///////////////////////////////////////
// RGB → YUV helpers (BT.709)
///////////////////////////////////////

const mat3 rgb2yuv = mat3(
    0.2126,  0.7152,  0.0722,
   -0.1146, -0.3854,  0.5000,
    0.5000, -0.4542, -0.0458);

// Convert linear RGB [0‑1] to YUV (BT.709, full‑range) and scale to 10‑bit
uvec3 rgb_to_yuv10(vec3 rgb)
{
    vec3 yuv = rgb2yuv * rgb;
    yuv.x = pc.fullSwing == 1u ? yuv.x : yuv.x * 0.858 + 0.062; // limited range 64‑940
    yuv.yz += 0.5; // center chroma
    yuv = clamp(yuv, 0.0, 1.0);
    return uvec3(round(yuv * 1023.0));
}

///////////////////////////////////////
// Main
///////////////////////////////////////

void main()
{
    uvec2 gid = gl_GlobalInvocationID.xy;
    uint y = gid.y;
    uint x0 = gid.x * 2u;           // two‑pixel macropixel (Y0 U Y1 V)
    uint x1 = x0 + 1u;

    if (y >= pc.height || x0 >= pc.width)
        return;

    vec3 rgb0 = demosaic(x0, y);
    vec3 rgb1 = (x1 < pc.width) ? demosaic(x1, y) : rgb0;

    uvec3 yuv0 = rgb_to_yuv10(rgb0);
    uvec3 yuv1 = rgb_to_yuv10(rgb1);

    uint y0 = yuv0.x;
    uint y1 = yuv1.x;
    uint u  = (yuv0.y + yuv1.y) >> 1; // average chroma for 4:2:2
    uint v  = (yuv0.z + yuv1.z) >> 1;

    // Pack into 32‑bit little‑endian: 10‑bit Y0 U Y1 V
    // bits 0‑9  : Y0
    // bits 10‑19: U
    // bits 20‑29: Y1
    // bits 30‑31: V[9:8] (we store full 10‑bit separately in .g, .b for simplicity)
    uint packed = (y0 & 0x3FFu) | ((u & 0x3FFu) << 10) | ((y1 & 0x3FFu) << 20) | ((v & 0x3FFu) << 30);

    imageStore(yuvImage, ivec2(gid), uvec4(packed, v & 0xFFu, 0u, 0u));
}

