#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform usampler2D rawImage;
// Packed 4x10-bit macropixels -> two dwords
layout(binding = 1, rg32ui) writeonly uniform uimage2D yuvImage;

layout(push_constant) uniform PushConsts {
    int width;
    int height;
} pc;

uint readU16(int x, int y) {
    x = clamp(x, 0, pc.width - 1);
    y = clamp(y, 0, pc.height - 1);
    return texelFetch(rawImage, ivec2(x, y), 0).r;
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    int x0 = gid.x * 2;
    int y = gid.y;
    if (x0 >= pc.width || y >= pc.height) return;
    int x1 = x0 + 1;
    uint y0 = readU16(x0, y) >> 6;
    uint y1 = (x1 < pc.width) ? (readU16(x1, y) >> 6) : y0;
    uint u  = 512u;
    uint v  = 512u;

    float fy0 = clamp(float(y0) + 64.0, 64.0, 940.0);
    float fy1 = clamp(float(y1) + 64.0, 64.0, 940.0);
    float fu  = clamp(float(u) + 512.0, 64.0, 960.0);
    float fv  = clamp(float(v) + 512.0, 64.0, 960.0);

    y0 = uint(fy0);
    y1 = uint(fy1);
    u  = uint(fu);
    v  = uint(fv);
    uint p0 = (y0 & 0x3FFu) | ((u & 0x3FFu) << 10) | ((y1 & 0x3FFu) << 20);
    uint p1 = (v & 0x3FFu);
    imageStore(yuvImage, gid, uvec4(p0, p1, 0, 0));
}
