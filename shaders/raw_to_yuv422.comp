#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform usampler2D rawImage;
layout(binding = 1, r16ui) writeonly uniform uimage2D yPlane;
layout(binding = 2, r16ui) writeonly uniform uimage2D uPlane;
layout(binding = 3, r16ui) writeonly uniform uimage2D vPlane;

struct ConvertInfo { int width; int height; int rowPitch; int unused; };
struct ColorPC { float wb[3]; float colorMat[9]; };
layout(push_constant) uniform PushConsts {
    ConvertInfo ci;
    ColorPC cp;
} pc;

uint readU16(int x,int y){
    x = clamp(x,0,pc.ci.width-1);
    y = clamp(y,0,pc.ci.height-1);
    return texelFetch(rawImage, ivec2(x,y),0).r;
}

vec3 lin2rgb(int x,int y){
    // simple nearest neighbour demosaic (BGGR only)
    bool ye = (y&1)==0; bool xe = (x&1)==0;
    float r=0.0,g=0.0,b=0.0;
    if(ye){
        if(xe){ b=float(readU16(x,y))/65535.0; g=float(readU16(x+1,y))/65535.0; r=float(readU16(x+1,y+1))/65535.0; }
        else { g=float(readU16(x,y))/65535.0; r=float(readU16(x+1,y))/65535.0; b=float(readU16(x,y+1))/65535.0; }
    }else{
        if(xe){ g=float(readU16(x,y))/65535.0; b=float(readU16(x+1,y))/65535.0; r=float(readU16(x,y+1))/65535.0; }
        else { r=float(readU16(x,y))/65535.0; g=float(readU16(x+1,y))/65535.0; b=float(readU16(x+1,y+1))/65535.0; }
    }
    return vec3(r,g,b);
}

vec3 rgb2yuv(vec3 rgb){
    const mat3 M = mat3( 0.2126,  0.7152,  0.0722,
                        -0.1146, -0.3854,  0.5000,
                         0.5000, -0.4542, -0.0458);
    vec3 yuv = M * rgb;
    yuv.x = clamp(yuv.x * 1023.0, 0.0, 1023.0);
    yuv.yz += 512.0;
    return yuv;
}

void main(){
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    int x0 = gid.x * 2;
    int y = gid.y;
    if(x0 >= pc.ci.width || y >= pc.ci.height) return;

    vec3 rgb0 = lin2rgb(x0,y);
    vec3 rgb1 = lin2rgb(x0+1,y);

    mat3 C = mat3(pc.cp.colorMat[0], pc.cp.colorMat[3], pc.cp.colorMat[6],
                  pc.cp.colorMat[1], pc.cp.colorMat[4], pc.cp.colorMat[7],
                  pc.cp.colorMat[2], pc.cp.colorMat[5], pc.cp.colorMat[8]);
    rgb0 = C * (rgb0 * vec3(pc.cp.wb[0], pc.cp.wb[1], pc.cp.wb[2]));
    rgb1 = C * (rgb1 * vec3(pc.cp.wb[0], pc.cp.wb[1], pc.cp.wb[2]));

    vec3 yuv0 = rgb2yuv(rgb0);
    vec3 yuv1 = rgb2yuv(rgb1);

    uint Y0 = uint(yuv0.x);
    uint U = uint(yuv0.y);
    uint Y1 = uint(yuv1.x);
    uint V = uint(yuv0.z);

    imageStore(yPlane, ivec2(x0,y), uvec4(Y0,0,0,0));
    imageStore(yPlane, ivec2(x0+1,y), uvec4(Y1,0,0,0));
    imageStore(uPlane, ivec2(x0/2,y), uvec4(U,0,0,0));
    imageStore(vPlane, ivec2(x0/2,y), uvec4(V,0,0,0));
}
