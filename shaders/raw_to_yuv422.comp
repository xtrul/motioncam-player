#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : enable
#extension GL_EXT_shader_16bit_storage               : require
#extension GL_KHR_shader_subgroup_basic              : enable
#extension GL_EXT_scalar_block_layout               : require

// ---------- bindings ----------
layout(set = 0, binding = 0, r16ui            ) readonly  uniform uimage2D  rawImg;   // 16-bit Bayer
layout(set = 0, binding = 1, rgba32ui         ) writeonly uniform uimage2D  yuvImg;   // 32-bit macropixel Y0 U Y1 V

// ---------- push constants ----------
layout(push_constant, scalar) uniform PC {
    uint   width, height;          // RAW dims
    uint   cfaType;                // 0=BGGR 1=RGGB 2=GBRG 3=GRBG
    uint   fullSwing;              // 0=studio (64-940) 1=full (0-1023)
    float  wbR, wbG, wbB;          // white-balance gains
    mat3   colMat;                 // 3×3 RGB->RGB matrix (sensor→BT.709)
} pc;

// ---------- helpers ----------
uint readRaw(uint x, uint y) {
    return imageLoad(rawImg, ivec2(x, y)).r;          // 16-bit
}

vec3 bayerToRGB(uint x, uint y) {
    // Simple bilinear demosaic (enough for validation)
    bool xe = (x & 1u) == 0u;
    bool ye = (y & 1u) == 0u;
    float r,g,b;

    uint cfa = pc.cfaType; // 0 BGGR | 1 RGGB | 2 GBRG | 3 GRBG
    #define RAW(xx,yy) float(readRaw(xx,yy)) / 1023.0

    if(cfa==0u){ // BGGR
        if( ye ){
            if( xe ){ b=RAW(x,y); g= (RAW(x-1,y)+RAW(x+1,y)+RAW(x,y-1)+RAW(x,y+1))*0.25; r=(RAW(x-1,y-1)+RAW(x+1,y-1)+RAW(x-1,y+1)+RAW(x+1,y+1))*0.25; }
            else     { g=RAW(x,y); b=(RAW(x-1,y  )+RAW(x+1,y  ))*0.5; r=(RAW(x  ,y-1)+RAW(x  ,y+1))*0.5; }
        }else{
            if( xe ){ g=RAW(x,y); b=(RAW(x  ,y-1)+RAW(x  ,y+1))*0.5; r=(RAW(x-1,y  )+RAW(x+1,y  ))*0.5; }
            else     { r=RAW(x,y); g= (RAW(x-1,y)+RAW(x+1,y)+RAW(x,y-1)+RAW(x,y+1))*0.25; b=(RAW(x-1,y-1)+RAW(x+1,y-1)+RAW(x-1,y+1)+RAW(x+1,y+1))*0.25; }
        }
    }else if(cfa==1u){ // RGGB
        if( ye ){
            if( xe ){ r=RAW(x,y); g= (RAW(x-1,y)+RAW(x+1,y)+RAW(x,y-1)+RAW(x,y+1))*0.25; b=(RAW(x-1,y-1)+RAW(x+1,y-1)+RAW(x-1,y+1)+RAW(x+1,y+1))*0.25; }
            else     { g=RAW(x,y); r=(RAW(x-1,y  )+RAW(x+1,y  ))*0.5; b=(RAW(x  ,y-1)+RAW(x  ,y+1))*0.5; }
        }else{
            if( xe ){ g=RAW(x,y); r=(RAW(x  ,y-1)+RAW(x  ,y+1))*0.5; b=(RAW(x-1,y  )+RAW(x+1,y  ))*0.5; }
            else     { b=RAW(x,y); g= (RAW(x-1,y)+RAW(x+1,y)+RAW(x,y-1)+RAW(x,y+1))*0.25; r=(RAW(x-1,y-1)+RAW(x+1,y-1)+RAW(x-1,y+1)+RAW(x+1,y+1))*0.25; }
        }
    }
    // add the two X-trans cases quickly if needed …

    vec3 rgb = vec3(r,g,b);

    // white-balance
    rgb *= vec3(pc.wbR, pc.wbG, pc.wbB);

    // colour space matrix
    rgb = pc.colMat * rgb;

    return clamp(rgb, 0.0, 1.0);
}

uvec4 packYUV(vec3 rgb0, vec3 rgb1){
    const vec3 Kr = vec3(0.2126,0.2126);
    const vec3 Kg = vec3(0.7152,0.7152);
    const vec3 Kb = vec3(0.0722,0.0722);

    float y0 = dot(rgb0, Kr.xxz + Kg.xyy + Kb.xzz);  // BT.709 luma
    float y1 = dot(rgb1, Kr.xxz + Kg.xyy + Kb.xzz);

    float u  = 0.5389 * (rgb0.b + rgb1.b - y0 - y1);   // average over the 2px pair
    float v  = 0.6350 * (rgb0.r + rgb1.r - y0 - y1);

    if(pc.fullSwing==0u){       // studio swing
        y0 = y0 * 876.0 + 64.0;
        y1 = y1 * 876.0 + 64.0;
        u  = u  * 448.0 + 512.0;
        v  = v  * 448.0 + 512.0;
    }else{                      // full swing
        y0 *= 1023.0;
        y1 *= 1023.0;
        u   = u * 511.5 + 512.0;
        v   = v * 511.5 + 512.0;
    }

    return uvec4(uint(y0+0.5), uint(u+0.5), uint(y1+0.5), uint(v+0.5));
}

layout(local_size_x = 32, local_size_y = 16, local_size_z = 1) in; // 1 work-item = 2 pixels horizontally
void main(){
    uvec2 gid   = gl_GlobalInvocationID.xy;   // each invocation outputs 2 horizontally-adjacent pixels
    uint x0     = gid.x * 2u;
    uint y      = gid.y;

    if(x0 >= pc.width || y >= pc.height) return;

    uint x1     = min(x0+1u, pc.width-1u);

    vec3 rgb0 = bayerToRGB(x0, y);
    vec3 rgb1 = bayerToRGB(x1, y);

    uvec4 macropix = packYUV(rgb0, rgb1);

    imageStore(yuvImg, ivec2(gid), macropix);

    // optional debug for first macro-pixel
    if(gid.x==0u && gid.y==0u){
        debugPrintfEXT("GPU y0=%u u=%u y1=%u v=%u\n", macropix.x, macropix.y, macropix.z, macropix.w);
    }
}
