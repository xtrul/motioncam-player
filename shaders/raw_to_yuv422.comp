#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : enable
#extension GL_EXT_shader_16bit_storage                   : require
#extension GL_KHR_shader_subgroup_basic                  : enable
#extension GL_EXT_scalar_block_layout                   : require
#extension GL_EXT_debug_print                           : enable   // for debugPrintfEXT

// ---------- bindings ----------
layout(set = 0, binding = 0, r16ui   ) readonly  uniform uimage2D rawImg;   // 16-bit Bayer
layout(set = 0, binding = 1, rgba32ui) writeonly uniform uimage2D yuvImg;   // Y0 U Y1 V macropixels

// ---------- push constants ----------
layout(push_constant, scalar) uniform PC {
    uint   width, height;        // RAW dimensions
    uint   cfaType;              // 0=BGGR 1=RGGB 2=GBRG 3=GRBG
    uint   fullSwing;            // 0=studio 64-940  1=full 0-1023
    float  wbR, wbG, wbB;        // white-balance gains
    mat3   colMat;               // sensor→BT.709 matrix
} pc;

// ---------- helper macros ----------
#define RAW(xx,yy) ( float(imageLoad(rawImg, ivec2(int(xx), int(yy))).r) / 1023.0 )

// ---------- functions ----------
vec3 bayerToRGB(uint x, uint y)
{
    // ── simple bilinear demosaic ───────────────────────────
    bool xe = (x & 1u) == 0u;
    bool ye = (y & 1u) == 0u;
    float r, g, b;

    switch (pc.cfaType)
    {
        // 0 = BGGR
        case 0u:
            if (ye) {
                if (xe) {                               // B G
                    b = RAW(x,y);
                    g = (RAW(x-1,y)+RAW(x+1,y)+RAW(x,y-1)+RAW(x,y+1))*0.25;
                    r = (RAW(x-1,y-1)+RAW(x+1,y-1)+RAW(x-1,y+1)+RAW(x+1,y+1))*0.25;
                } else {                                // G R
                    g = RAW(x,y);
                    b = (RAW(x-1,y)+RAW(x+1,y))*0.5;
                    r = (RAW(x,y-1)+RAW(x,y+1))*0.5;
                }
            } else {
                if (xe) {                               // G B
                    g = RAW(x,y);
                    b = (RAW(x,y-1)+RAW(x,y+1))*0.5;
                    r = (RAW(x-1,y)+RAW(x+1,y))*0.5;
                } else {                                // R G
                    r = RAW(x,y);
                    g = (RAW(x-1,y)+RAW(x+1,y)+RAW(x,y-1)+RAW(x,y+1))*0.25;
                    b = (RAW(x-1,y-1)+RAW(x+1,y-1)+RAW(x-1,y+1)+RAW(x+1,y+1))*0.25;
                }
            }
            break;

        // 1 = RGGB
        case 1u:
            if (ye) {
                if (xe) {                               // R G
                    r = RAW(x,y);
                    g = (RAW(x-1,y)+RAW(x+1,y)+RAW(x,y-1)+RAW(x,y+1))*0.25;
                    b = (RAW(x-1,y-1)+RAW(x+1,y-1)+RAW(x-1,y+1)+RAW(x+1,y+1))*0.25;
                } else {                                // G B
                    g = RAW(x,y);
                    r = (RAW(x-1,y)+RAW(x+1,y))*0.5;
                    b = (RAW(x,y-1)+RAW(x,y+1))*0.5;
                }
            } else {
                if (xe) {                               // G R
                    g = RAW(x,y);
                    r = (RAW(x,y-1)+RAW(x,y+1))*0.5;
                    b = (RAW(x-1,y)+RAW(x+1,y))*0.5;
                } else {                                // B G
                    b = RAW(x,y);
                    g = (RAW(x-1,y)+RAW(x+1,y)+RAW(x,y-1)+RAW(x,y+1))*0.25;
                    r = (RAW(x-1,y-1)+RAW(x+1,y-1)+RAW(x-1,y+1)+RAW(x+1,y+1))*0.25;
                }
            }
            break;

        // TODO: 2 = GBRG, 3 = GRBG if your camera uses them
        default:
            r = g = b = 0.0;
            break;
    }

    vec3 rgb = vec3(r, g, b);

    // white balance
    rgb *= vec3(pc.wbR, pc.wbG, pc.wbB);

    // colour matrix
    rgb = pc.colMat * rgb;

    return clamp(rgb, 0.0, 1.0);
}

uvec4 packYUV(vec3 rgb0, vec3 rgb1)
{
    // BT.709 coefficients
    const vec3 kr = vec3(0.2126);
    const vec3 kg = vec3(0.7152);
    const vec3 kb = vec3(0.0722);

    float y0 = dot(rgb0, vec3(kr.x, kg.x, kb.x));
    float y1 = dot(rgb1, vec3(kr.x, kg.x, kb.x));

    float u  = 0.5389 * ((rgb0.b + rgb1.b) - (y0 + y1));
    float v  = 0.6350 * ((rgb0.r + rgb1.r) - (y0 + y1));

    if (pc.fullSwing == 0u) {          // studio swing
        y0 = y0 * 876.0 + 64.0;
        y1 = y1 * 876.0 + 64.0;
        u  = u  * 448.0 + 512.0;
        v  = v  * 448.0 + 512.0;
    } else {                           // full swing
        y0 *= 1023.0;
        y1 *= 1023.0;
        u   = u * 511.5 + 512.0;
        v   = v * 511.5 + 512.0;
    }

    return uvec4(uint(y0 + 0.5),
                 uint(u  + 0.5),
                 uint(y1 + 0.5),
                 uint(v  + 0.5));
}

// ---------- work-group size ----------
layout(local_size_x = 32, local_size_y = 16, local_size_z = 1) in;

// ---------- main ----------
void main()
{
    uvec2 gid = gl_GlobalInvocationID.xy;   // one invocation = 2 horizontally-adjacent pixels
    uint  x0  = gid.x * 2u;
    uint  y   = gid.y;

    if (x0 >= pc.width || y >= pc.height)
        return;

    uint x1 = min(x0 + 1u, pc.width - 1u);

    vec3 rgb0 = bayerToRGB(x0, y);
    vec3 rgb1 = bayerToRGB(x1, y);

    uvec4 macropixel = packYUV(rgb0, rgb1);
    imageStore(yuvImg, ivec2(gid), macropixel);

#ifdef GL_EXT_debug_print
    if (gid.x == 0u && gid.y == 0u) {
        debugPrintfEXT("GPU first macro-pixel: Y0=%u U=%u Y1=%u V=%u\n",
                       macropixel.x, macropixel.y, macropixel.z, macropixel.w);
    }
#endif
}
